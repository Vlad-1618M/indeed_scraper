# =============================================================================
# Indeed Scraper - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# DO NOT commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# TIMEZONE
# -----------------------------------------------------------------------------
TZ=America/New_York

# -----------------------------------------------------------------------------
# PROXY CONFIGURATION (Optional but recommended for production)
# -----------------------------------------------------------------------------
# Residential proxy providers:
#   - IPRoyal: https://iproyal.com (~$7/GB)
#   - Smartproxy: https://smartproxy.com (~$8.5/GB)
#   - Bright Data: https://brightdata.com (~$15/GB)

# Proxy server URL (include port)
PROXY_SERVER=

# Proxy authentication (if required)
PROXY_USER=
PROXY_PASS=

# -----------------------------------------------------------------------------
# INDEED CREDENTIALS (Optional - for logged-in features)
# -----------------------------------------------------------------------------
# Only needed if you want to access saved jobs or apply features
INDEED_EMAIL=
INDEED_PASSWORD=

# -----------------------------------------------------------------------------
# SCRAPER SETTINGS
# -----------------------------------------------------------------------------
# Default scraper: seleniumbase, playwright, camoufox, selenium
DEFAULT_SCRAPER=seleniumbase

# Default search parameters
DEFAULT_QUERY=DevOps Engineer
DEFAULT_LOCATION=Remote
DEFAULT_MAX_RESULTS=25
DEFAULT_DAYS=7

# -----------------------------------------------------------------------------
# REPORT SERVER (host + Docker report-server service)
# -----------------------------------------------------------------------------
# Host bind address (127.0.0.1 locally; Docker compose sets 0.0.0.0 in-container)
REPORT_HOST=127.0.0.1

# Port published to host browser (docker-compose maps REPORT_PORT:8765)
REPORT_PORT=8765
