# =============================================================================
# Indeed Scraper - Git Ignore
# =============================================================================
# local dev:
local_dev_notes
downloaded_files
artifacts
.DS_Store
maintance/drivers

# Environment and secrets
.env
.env.local
*.env

# Artifacts (generated data)
artifacts/json/*
artifacts/logs/*
artifacts/screenshots/*
!artifacts/json/.gitkeep
!artifacts/logs/.gitkeep
!artifacts/screenshots/.gitkeep

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
# build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log

# Testing
.pytest_cache/
.coverage
htmlcov/

# Docker
.docker/

# Camoufox browser data
camoufox_data/
